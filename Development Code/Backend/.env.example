# HMS Portal: Backend Environment Variables
# Use this to configure your Render/Railway deployment

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://admin:secure_password@cluster0.abcde.mongodb.net/hms_db

# JWT Secret for authentication
JWT_SECRET=your_super_secret_string_here

# Port (Optional, Render provides this automatically)
PORT=3001

# Frontend URL (Your Vercel site URL, e.g. https://hms-portal.vercel.app)
FRONTEND_URL=https://your-hms-portal.vercel.app
